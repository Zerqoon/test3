{
  "name": "goat-clan-bot",
  "version": "2.3.0",
  "private": true,
  "description": "GOAT clan Discord bot \u2014 immutable usernames, audit logs, giveaways and activity tracking",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "register": "node dist/scripts/register-commands.js",
    "preview": "node dist/scripts/welcome-preview.js",
    "doctor": "node dist/scripts/doctor.js",
    "backup": "node dist/scripts/backup.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.83",
    "discord.js": "14.27.0",
    "dotenv": "^17.2.3",
    "luxon": "^3.7.2",
    "pino": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
