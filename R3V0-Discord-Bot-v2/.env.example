# Create a bot in https://discord.com/developers/applications
# On Railway, enter these settings in the service's Variables tab instead of uploading .env.
# Railway setup: RAILWAY_SETUP_PL.md. Keep the token private.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Optional: detected from the configured username channel when left empty.
GUILD_ID=
# Optional for the standalone register command; start detects this automatically.
APPLICATION_ID=
DATABASE_PATH=./data/goat.sqlite
# On Railway use DATABASE_PATH=/app/data/goat.sqlite, mount a volume at /app/data,
# and set RAILWAY_RUN_UID=0 so the Docker process can write to that volume.
LOG_LEVEL=info
VALUE_SITE_URL=https://petuniverse-values.pl
