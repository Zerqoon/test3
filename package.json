{
  "name": "r3v0-ps99-whitelist-bot",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/database/migrations', { recursive: true }); fs.cpSync('src/database/migrations', 'dist/database/migrations', { recursive: true, force: true });\"",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write .",
    "commands:deploy": "tsx scripts/deploy-commands.ts",
    "commands:clear": "tsx scripts/clear-commands.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "diagnostics": "tsx scripts/diagnostics.ts",
    "canvas:smoke": "tsx scripts/canvas-smoke.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "pino": "^10.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
